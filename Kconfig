menu "4D Systems ESP32-S3 4D LCD Display Selection"

choice
    prompt "Select your display series"

config ESP32S3_LCD_24
    bool "gen4-ESP32-24 Series"
    select LCD_INTERFACE_SPI
    help
      Select this if your 4D display is 2.4-inch

config ESP32S3_LCD_28
    select LCD_INTERFACE_SPI
    bool "gen4-ESP32-28 Series"
    help
      Select this if your 4D display is 2.8-inch

config ESP32S3_LCD_32
    bool "gen4-ESP32-32 Series"
    select LCD_INTERFACE_SPI
    help
      Select this if your 4D display is 3.2-inch

config ESP32S3_LCD_35
    bool "gen4-ESP32-35 Series"
    select LCD_INTERFACE_SPI
    help
      Select this if your 4D display is 3.5-inch

config ESP32S3_LCD_43Q
    bool "gen4-ESP32Q-43 Series"
    select LCD_INTERFACE_QSPI
    help
      Select this if your 4D display is 4.3-inch QSPI (480x272)

config ESP32S3_LCD_43
    bool "gen4-ESP32-43 Series"
    select LCD_INTERFACE_RGB
    help
      Select this if your 4D display is 4.3-inch RGB (800x480)

config ESP32S3_LCD_50
    bool "gen4-ESP32-50 Series"
    select LCD_INTERFACE_RGB
    help
      Select this if your 4D display is 5-inch

config ESP32S3_LCD_70
    bool "gen4-ESP32-70 Series"
    select LCD_INTERFACE_RGB
    help
      Select this if your 4D display is 7-inch

config ESP32S3_LCD_90
    bool "ESP32-90 Series"
    select LCD_INTERFACE_RGB
    help
      Select this if your 4D display is 9-inch

endchoice

choice
    prompt "Select your SPI host to use with the LCD"
    depends on ESP32S3_LCD_24 || ESP32S3_LCD_28 || ESP32S3_LCD_32 || ESP32S3_LCD_35 || ESP32S3_LCD_43Q

config ESP32S3_LCD_SPI2
    bool "SPI2"
    help
      Select this if you wish to use SPI2 with the SPI/QSPI LCD

config ESP32S3_LCD_SPI3
    bool "SPI3"
    help
      Select this if you wish to use SPI3 with the SPI/QSPI LCD
endchoice


config LCD_INTERFACE_SPI
    bool
    default n

config LCD_INTERFACE_QSPI
    bool
    default n

config LCD_INTERFACE_RGB
    bool
    default n

# Opt-out of the forced-PSRAM requirement. Only offered for the SPI and QSPI
# displays. RGB displays all require PSRAM for their framebuffer size regardless
# of this setting, so it's intentionally not selectable there.
config ESP32S3_LCD_ALLOW_NOPSRAM
    bool "Allow running without PSRAM (2.4/2.8/3.2/3.5 SPI and 4.3 QSPI only)"
    depends on ESP32S3_LCD_24 || ESP32S3_LCD_28 || ESP32S3_LCD_32 || ESP32S3_LCD_35 || ESP32S3_LCD_43Q
    default n
    help
      By default this component requires PSRAM regardless of the needs for a large
      framebuffer. Enable this only if you have verified your application's framebuffers
      and other allocations fit in internal RAM alongside WiFi/BT on SPI/QSPI displays.

endmenu